# Copy to .env and adjust. Never commit .env.

# local = loopback dashboard; production = Vercel frontend + Render API
ENVIRONMENT=local
# Required when ENVIRONMENT=production (no trailing slash)
# FRONTEND_ORIGIN=https://your-app.vercel.app

# Which model provider: "fake" | "ollama" | "hermes" | "openai".
# openai = OpenAI-compatible cloud (Groq / OpenRouter free models) for production.
# hermes = local Hermes only when installed, context ≥64000, and base URL is local Ollama.
PERSONAL_AGENT_PROVIDER=ollama

# Ollama (local inference)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=180.0
OLLAMA_MAX_OUTPUT_TOKENS=256
OLLAMA_CONTEXT_TOKENS=4096
OLLAMA_KEEP_ALIVE=10m

# Production / free cloud inference (PERSONAL_AGENT_PROVIDER=openai)
# Prefer OPENAI_COMPAT_*; HERMES_API_KEY / HERMES_BASE_URL / HERMES_MODEL also work as fallbacks.
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=llama-3.1-8b-instant
# OPENAI_COMPAT_TIMEOUT_SECONDS=90
# OPENAI_COMPAT_MAX_OUTPUT_TOKENS=1024

# SQLite locally; Supabase Postgres in production (pooler URL).
# postgres:// and postgresql:// are normalized to postgresql+psycopg:// automatically.
DATABASE_URL=sqlite:///./data/agent.db
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# How much of the conversation history to send back to the model.
HISTORY_LIMIT=20

# Dashboard approval requests wait this long for a decision before timing out.
APPROVAL_TIMEOUT_SECONDS=120.0
# Per-run limits (BR-09): tool rounds and wall-clock seconds before AURA stops with a summary.
RUN_MAX_TOOL_ROUNDS=6
RUN_MAX_SECONDS=90

# Logging
LOG_LEVEL=INFO

# --- Telegram integration (optional) ------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Run personal-agent init-dashboard to generate a signing key, then register in the UI.
# DASHBOARD_PASSWORD_HASH=<salt_base64url>$<hash_base64url>
# DASHBOARD_SECRET_KEY=<random secret, at least 32 characters>

# Hermes orchestration (local Ollama only — no paid cloud model APIs)
# PERSONAL_AGENT_PROVIDER=hermes
HERMES_DIRECTORY=data/hermes
# Leave HERMES_MODEL / HERMES_BASE_URL empty to use OLLAMA_MODEL and OLLAMA_BASE_URL/v1.
# HERMES_MODEL=
# HERMES_BASE_URL=
# HERMES_API_KEY=
# Hermes path requires at least 64000 context tokens; otherwise AURA uses the Ollama agent loop.
HERMES_CONTEXT_TOKENS=4096

# --- Google OAuth (optional, free Cloud client) --------------------------------
# Enables Gmail / Calendar / Drive connect in AURA.
# Create a Web application OAuth client; never commit real values.
# Local redirect: http://127.0.0.1:8000/api/google/callback
# Production redirect (later cutover): https://<your-render-host>/api/google/callback
# Enable Gmail API, Google Calendar API, and Google Drive API on the GCP project.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/google/callback
