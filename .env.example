# Copy to .env and adjust. Never commit .env.

# Which model provider to use: "fake" (offline/testing) or "ollama".
PERSONAL_AGENT_PROVIDER=ollama

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# SQLite now; e.g. postgresql+psycopg://user:pass@host/db when justified later.
DATABASE_URL=sqlite:///./data/agent.db

# How much of the conversation history to send back to the model.
HISTORY_LIMIT=20

# Minimum waiting time for approval requests (seconds) — CLI prompts immediately.
APPROVAL_TIMEOUT_SECONDS=10.0

# Logging
LOG_LEVEL=INFO
