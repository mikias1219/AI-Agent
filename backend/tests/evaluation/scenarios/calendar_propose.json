{
  "id": "calendar_propose",
  "input": "Propose a 30-minute slot with Sam next week",
  "script": [
    {
      "tool_calls": [
        {
          "id": "c1",
          "name": "google_calendar_find_free_slots",
          "arguments": {
            "time_min": "2026-11-17T09:00:00Z",
            "time_max": "2026-11-21T18:00:00Z",
            "duration_minutes": 30
          }
        }
      ]
    },
    {
      "content": "Proposed Tuesday at 14:00 with Sam."
    }
  ],
  "expect": {
