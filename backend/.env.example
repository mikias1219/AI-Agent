# Copy to .env and adjust. Never commit .env.

# local = loopback dashboard; production = Vercel frontend + Render API
ENVIRONMENT=local
# Required when ENVIRONMENT=production (no trailing slash)
# FRONTEND_ORIGIN=https://your-app.vercel.app

# Which model provider to use: "fake" (offline/testing), "ollama", or "hermes".
PERSONAL_AGENT_PROVIDER=hermes

# Ollama settings (local only; not used on Render when Hermes+OpenRouter is configured)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=180.0
OLLAMA_MAX_OUTPUT_TOKENS=256
OLLAMA_CONTEXT_TOKENS=4096
OLLAMA_KEEP_ALIVE=10m

# SQLite locally; Supabase Postgres in production (pooler URL).
# postgres:// and postgresql:// are normalized to postgresql+psycopg:// automatically.
DATABASE_URL=sqlite:///./data/agent.db
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# How much of the conversation history to send back to the model.
HISTORY_LIMIT=20

# Dashboard approval requests wait this long for a decision before timing out.
APPROVAL_TIMEOUT_SECONDS=10.0

# Logging
LOG_LEVEL=INFO

# --- Telegram integration (optional) ------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Run personal-agent init-dashboard to generate a signing key, then register in the UI.
# DASHBOARD_PASSWORD_HASH=<salt_base64url>$<hash_base64url>
# DASHBOARD_SECRET_KEY=<random secret, at least 32 characters>

# Hermes orchestration (OpenRouter in production):
# PERSONAL_AGENT_PROVIDER=hermes
HERMES_DIRECTORY=data/hermes
# Use a model that actually returns text (openrouter/free often finishes empty).
HERMES_MODEL=openrouter/auto
HERMES_BASE_URL=https://openrouter.ai/api/v1
HERMES_API_KEY=
# Hermes requires at least 64000 context tokens.
HERMES_CONTEXT_TOKENS=64000
