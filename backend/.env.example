# Copy to .env and adjust. Never commit .env.

# Which model provider to use: "fake" (offline/testing) or "ollama".
PERSONAL_AGENT_PROVIDER=ollama

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=180.0
# Bound response length and avoid repeated model reloads on CPU-only laptops.
OLLAMA_MAX_OUTPUT_TOKENS=256
OLLAMA_CONTEXT_TOKENS=4096
OLLAMA_KEEP_ALIVE=10m

# SQLite now; e.g. postgresql+psycopg://user:pass@host/db when justified later.
DATABASE_URL=sqlite:///./data/agent.db

# How much of the conversation history to send back to the model.
HISTORY_LIMIT=20

# Dashboard approval requests wait this long for a decision before timing out.
APPROVAL_TIMEOUT_SECONDS=10.0

# Logging
LOG_LEVEL=INFO

# --- Telegram integration (optional) ------------------------------------------
# Create a bot with @BotFather, copy the token here (it is a secret).
TELEGRAM_BOT_TOKEN=
# Chats (including groups/negative ids) the bot is allowed to serve; fail-closed
# when empty. Find your chat id by sending your bot a message and checking the log.
TELEGRAM_ALLOWED_CHAT_IDS=

# Run personal-agent init-dashboard to generate a signing key, then register in the UI.
# Existing password-only setups may keep DASHBOARD_PASSWORD_HASH:
# DASHBOARD_PASSWORD_HASH=<salt_base64url>$<hash_base64url>
# DASHBOARD_SECRET_KEY=<random secret, at least 32 characters>

# Hermes orchestration (uses the Ollama settings above):
# PERSONAL_AGENT_PROVIDER=hermes
HERMES_DIRECTORY=data/hermes
# Optional OpenAI-compatible cloud model (enter the key only in backend/.env):
HERMES_MODEL=
HERMES_BASE_URL=
HERMES_API_KEY=
# Hermes currently requires 64000+. Leave the working Ollama agent selected
# until you have configured and verified a model supporting that context.
HERMES_CONTEXT_TOKENS=4096
