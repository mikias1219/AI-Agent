{
  "id": "email_read_then_draft",
  "input": "Read the latest email and draft a short reply",
  "stubs": {
    "google_gmail_read": {
      "data": {
        "id": "m1",
        "subject": "Hello",
        "from": "sam@example.com",
        "body": "Can we meet Thursday?",
        "snippet": "Can we meet"
      }
    }
  },
  "script": [
    {
      "tool_calls": [
        {
          "id": "c1",
          "name": "google_gmail_read",
          "arguments": {
            "message_id": "m1"
          }
        },
        {
          "id": "c2",
          "name": "google_gmail_create_draft",
          "arguments": {
            "to": "sam@example.com",
            "subject": "Re: Hello",
            "body": "Thursday works for me."
          }
        }
      ]
    },
    {
      "content": "I read the email and drafted a reply."
    }
  ],
  "expect": {
    "tool_calls": [
      "google_gmail_read",
      "google_gmail_create_draft"
    ],
    "text_contains": [
      "draft"
    ]
  }
}
